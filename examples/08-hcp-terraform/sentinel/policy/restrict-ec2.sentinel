# Every EC2 instance being created or updated must
#   1. have a Name tag
#   2. use one of the allowed instance types
import "tfplan/v2" as tfplan

allowed_types = ["t2.micro", "t2.small", "t2.medium"]

# resources in the plan that this policy cares about
ec2_instances = filter tfplan.resource_changes as _, rc {
	rc.type is "aws_instance" and
		rc.mode is "managed" and
		(rc.change.actions contains "create" or rc.change.actions contains "update")
}

has_name_tag = rule {
	all ec2_instances as _, rc {
		rc.change.after.tags else {} contains "Name"
	}
}

type_is_allowed = rule {
	all ec2_instances as _, rc {
		rc.change.after.instance_type in allowed_types
	}
}

# main is the rule HCP Terraform reads for pass/fail
main = rule {
	has_name_tag and type_is_allowed
}
